{% set attrKeys = ['agility', 'brawn', 'combat', 'perception', 'intelligence', 'willpower', 'fellowship'] %}
{% set attrLabels = ['Agility', 'Brawn', 'Combat', 'Perception', 'Intelligence', 'Willpower', 'Fellowship'] %}
{% set attrCodes = ['AB', 'BB', 'CB', 'PB', 'IB', 'WB', 'FB'] %}
{% set attrKeywordSets = [
    ['undefoot', 'deadly aim'],
    ['mountain among men', 'inhuman strength', 'big folk', 'monstrous body'],
    ['combat prowess'],
    [],
    [],
    [],
    []
] %}
{% macro countAdvances(variables, attrName) %}
    {% set count = 0 %}
    {% for i in 1..6 %}
        {% for j in 10..15 %}
            {% for tier in ['basic', 'intermediate', 'advanced'] %}
                {% if attribute(variables, "profession_" ~ tier ~ "_toggle_" ~ j) == true and attribute(variables, "profession_" ~ tier ~ "_bonus_" ~ i) == attrName %}
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endfor %}
    {{ count }}
{% endmacro %}
{% set attrValue = [] %}
{% set attrAdvance = [] %}
{% set attrAncestral = [] %}
{% set attrCustom = [] %}
{% set attrBonusFinal = [] %}
{% for idx in 0..6 %}
    {% set key = attrKeys[idx] %}
    {% set label = attrLabels[idx] %}
    {% set keywords = attrKeywordSets[idx] %}
    {# Base value #}
    {% set baseVal = attribute(variables, "attribute_" ~ key) %}
    {% set attrValue = attrValue|merge([baseVal]) %}
    {# +5% profession attribute bonus (toggle 7) #}
    {% set bonus5 = 0 %}
    {% for tier in ['basic', 'intermediate', 'advanced'] %}
        {% if attribute(variables, "profession_" ~ tier ~ "_toggle_7") == true and attribute(variables, "profession_" ~ tier ~ "_attribute") == (label ~ " +5%") %}
            {% set bonus5 = bonus5 + 5 %}
        {% endif %}
    {% endfor %}
    {# Advance count #}
    {% set adv = _self.countAdvances(variables, label)|trim|number_format(0) %}
    {% set attrAdvance = attrAdvance|merge([adv]) %}
    {# Ancestral talent bonus (toggle 9) #}
    {% set ancestralBonus = 0 %}
    {% for tier in ['basic', 'intermediate', 'advanced'] %}
        {% set toggleOn = attribute(variables, "profession_" ~ tier ~ "_toggle_9") %}
        {% set talentText = attribute(variables, "profession_" ~ tier ~ "_ancestral_talent")|lower %}
        {% if toggleOn == true %}
            {% for kw in keywords %}
                {% if kw in talentText %}
                    {% set ancestralBonus = ancestralBonus + 1 %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}
    {% set attrAncestral = attrAncestral|merge([ancestralBonus]) %}
    {# Custom bonus #}
    {% set customBonus = attribute(variables, key ~ "_bonus_custom") %}
    {% set attrCustom = attrCustom|merge([customBonus]) %}
    {# Final bonus #}
    {% set bonusFinal = (baseVal / 10)|round(0, 'floor') + adv + customBonus + ancestralBonus %}
    {% set attrBonusFinal = attrBonusFinal|merge([bonusFinal]) %}
{% endfor %}
{# --- Skills --- #}
{% set skillNames = ['Athletics', 'Awareness', 'Blackpowder', 'Coordination', 'Craft', 'Disguise', 'Folklore', 'Gamble', 'Guile', 'Handling', 'Insight', 'Leechcraft', 'Melee', 'Occultism', 'Persuasion', 'Ranged', 'Resolve', 'Stealth', 'Survival', 'Thievery', 'Toughness'] %}
{# governsIdx maps each skill to its index in attrKeys (0=agility,1=brawn,2=combat,3=perception,4=intelligence,5=willpower,6=fellowship) #}
{% set skillGovernsIdx = [1, 3, 2, 0, 5, 6, 4, 4, 6, 1, 3, 4, 2, 5, 6, 2, 5, 0, 3, 0, 1] %}
<!-- ancestral talents that impact skills -->
{# Ancestral talent text, gathered once — reused for both Jack of All Trades and flat skill bonuses #}
{% set ancestralTalentTexts = [] %}
{% for tier in ['basic', 'intermediate', 'advanced'] %}
    {% if attribute(variables, "profession_" ~ tier ~ "_toggle_9") == true %}
        {% set ancestralTalentTexts = ancestralTalentTexts|merge([attribute(variables, "profession_" ~ tier ~ "_ancestral_talent")|lower]) %}
    {% endif %}
{% endfor %}
{% set jackActive = false %}
{% for txt in ancestralTalentTexts %}
    {% if 'jack of all trades' in txt %}
        {% set jackActive = true %}
    {% endif %}
{% endfor %}
{# Flat +5% ancestral bonuses per skill, indexed to match skillNames #}
{% set skillKeywordSets = [
    [], [], [], [], [], [], [], [], [], [], [], [],
    ['winter king\'s embrace', 'razor-sharp claws', 'mighty thews', 'horrific claws', 'cloak & dagger', 'saber-toothed'],
    [],
    [],
    ['fieldwarden', 'blue-blooded'],
    [], [], [], [], []
] %}
<!-- talismans -->
{% set talisman_objects = [] %}
{% for i in 2..10 %}
    {% set talisman_objects = talisman_objects|merge([variables["object_" ~ i]|default('')|lower]) %}
{% endfor %}
{% set talismanBonus = [] %}
{% for skill in skillNames %}
    {% set found = [false] %}
    {% for obj in talisman_objects %}
        {% if obj is not empty and ('talisman of ' ~ skill|lower) in obj %}
            {% set found = [true] %}
        {% endif %}
    {% endfor %}
    {% set talismanBonus = talismanBonus|merge([found[0] ? 5 : 0]) %}
{% endfor %}
<!-- final skill calculation -->
{% set skillAdvance = [] %}
{% set skillRankRaw = [] %}
{% set skillTotal = [] %}
{% for i in 0..20 %}
    {% set skillName = skillNames[i] %}
    {% set count = 0 %}
    {% for tier in ['basic', 'intermediate', 'advanced'] %}
        {% for j in 1..6 %}
            {% set skillVal = attribute(variables, "profession_" ~ tier ~ "_skill_" ~ j)|default('') %}
            {% set toggleVal = attribute(variables, "profession_" ~ tier ~ "_toggle_" ~ j)|default(0) %}
            {% if skillVal == skillName and toggleVal == 1 %}
                {% set count = count + 1 %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% set skillRankRaw = skillRankRaw|merge([count]) %}
    {% set adv = count > 3 ? 3 : count %}
    {% set skillAdvance = skillAdvance|merge([adv]) %}
    {# Flat keyword-based ancestral bonus #}
    {% set keywordBonus = 0 %}
    {% set keywords = skillKeywordSets[i] %}
    {% for kw in keywords %}
        {% for txt in ancestralTalentTexts %}
            {% if kw in txt %}
                {% set keywordBonus = 5 %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {# Jack of All Trades: +5% only if this skill has zero ranks #}
    {% set jackBonus = (jackActive and count == 0) ? 5 : 0 %}
    {% set govIdx = skillGovernsIdx[i] %}
    {% set total = attrValue[govIdx] + (adv * 10) + talismanBonus[i] + keywordBonus + jackBonus %}
    {% set skillTotal = skillTotal|merge([total]) %}
{% endfor %}
<!-- attribute bonus sums -->
{% set attribute_agility_bonus_final = attrBonusFinal[0] %}
{% set attribute_brawn_bonus_final = attrBonusFinal[1] %}
{% set attribute_combat_bonus_final = attrBonusFinal[2] %}
{% set attribute_perception_bonus_final = attrBonusFinal[3] %}
{% set attribute_intelligence_bonus_final = attrBonusFinal[4] %}
{% set attribute_willpower_bonus_final = attrBonusFinal[5] %}
{% set attribute_fellowship_bonus_final = attrBonusFinal[6] %}
<!-- attribute bonus advances -->
{% set attribute_agility_advance_array = attrAdvance[0] %}
{% set attribute_brawn_advance_array = attrAdvance[1] %}
{% set attribute_combat_advance_array = attrAdvance[2] %}
{% set attribute_perception_advance_array = attrAdvance[3] %}
{% set attribute_intelligence_advance_array = attrAdvance[4] %}
{% set attribute_willpower_advance_array = attrAdvance[5] %}
{% set attribute_fellowship_advance_array = attrAdvance[6] %}
<!-- final attribute values -->
{% set attribute_agility_final = attrValue[0] %}
{% set attribute_brawn_final = attrValue[1] %}
{% set attribute_combat_final = attrValue[2] %}
{% set attribute_perception_final = attrValue[3] %}
{% set attribute_intelligence_final = attrValue[4] %}
{% set attribute_willpower_final = attrValue[5] %}
{% set attribute_fellowship_final = attrValue[6] %}
<!-- skill advances and totals -->
{% set athletics_advance = skillAdvance[0] %}     {% set skill_athletics_total = skillTotal[0] %}
{% set awareness_advance = skillAdvance[1] %}     {% set skill_awareness_total = skillTotal[1] %}
{% set blackpowder_advance = skillAdvance[2] %}   {% set skill_blackpowder_total = skillTotal[2] %}
{% set coordination_advance = skillAdvance[3] %}  {% set skill_coordination_total = skillTotal[3] %}
{% set craft_advance = skillAdvance[4] %}         {% set skill_craft_total = skillTotal[4] %}
{% set disguise_advance = skillAdvance[5] %}      {% set skill_disguise_total = skillTotal[5] %}
{% set folklore_advance = skillAdvance[6] %}      {% set skill_folklore_total = skillTotal[6] %}
{% set gamble_advance = skillAdvance[7] %}        {% set skill_gamble_total = skillTotal[7] %}
{% set guile_advance = skillAdvance[8] %}         {% set skill_guile_total = skillTotal[8] %}
{% set handling_advance = skillAdvance[9] %}      {% set skill_handling_total = skillTotal[9] %}
{% set insight_advance = skillAdvance[10] %}      {% set skill_insight_total = skillTotal[10] %}
{% set leechcraft_advance = skillAdvance[11] %}   {% set skill_leechcraft_total = skillTotal[11] %}
{% set melee_advance = skillAdvance[12] %}        {% set skill_melee_total = skillTotal[12] %}
{% set occultism_advance = skillAdvance[13] %}    {% set skill_occultism_total = skillTotal[13] %}
{% set persuasion_advance = skillAdvance[14] %}   {% set skill_persuasion_total = skillTotal[14] %}
{% set ranged_advance = skillAdvance[15] %}       {% set skill_ranged_total = skillTotal[15] %}
{% set resolve_advance = skillAdvance[16] %}      {% set skill_resolve_total = skillTotal[16] %}
{% set stealth_advance = skillAdvance[17] %}      {% set skill_stealth_total = skillTotal[17] %}
{% set survival_advance = skillAdvance[18] %}     {% set skill_survival_total = skillTotal[18] %}
{% set thievery_advance = skillAdvance[19] %}     {% set skill_thievery_total = skillTotal[19] %}
{% set toughness_advance = skillAdvance[20] %}    {% set skill_toughness_total = skillTotal[20] %}
<!-- current profession selector -->
{% if variables.profession_advanced != "" %}
    {% set profession_current = variables.profession_advanced %}
{% elseif variables.profession_intermediate != "" %}
    {% set profession_current = variables.profession_intermediate %}
{% else %}
    {% set profession_current = variables.profession_basic %}
{% endif %}
<!-- peril threshold calculactions -->
{% set peril_base = attrBonusFinal[5] + 3 %}
<!-- general talent: Salt Of The Earth -->
{% set talent_pth_salt = 0 %}
{% for n in 1..3 %}
    {% if variables["profession_basic_toggle_" ~ (15 + n)] == true and "Salt Of The Earth" in variables["profession_basic_talent_" ~ n]|lower
       or variables["profession_intermediate_toggle_" ~ (15 + n)] == true and "Salt Of The Earth" in variables["profession_intermediate_talent_" ~ n]|lower
       or variables["profession_advanced_toggle_" ~ (15 + n)] == true and "Salt Of The Earth" in variables["profession_advanced_talent_" ~ n]|lower %}
        {% set talent_pth_salt = 3 %}
    {% endif %}
{% endfor %}
<!-- ancestral talents affecting peril threshold -->
{% set saltborneActive = false %}
{% set servantActive = false %}
{% set ironcladActive = false %}
{% set broadBelliedActive = false %}
{% for txt in ancestralTalentTexts %}
    {% if 'saltborne' in txt %}
        {% set saltborneActive = true %}
    {% endif %}
    {% if 'servant of the steward' in txt %}
        {% set servantActive = true %}
    {% endif %}
    {% if 'ironclad' in txt %}
        {% set ironcladActive = true %}
    {% endif %}
    {% if 'broad-bellied' in txt %}
        {% set broadBelliedActive = true %}
    {% endif %}
{% endfor %}
{% set talent_pth_total = 0 %}
{% if saltborneActive %}
    {# Saltborne overrides ALL other talent-based Peril Threshold bonuses, ancestral or general #}
    {% set talent_pth_total = 3 %}
{% else %}
    {% set talent_pth_total = talent_pth_salt %}
    {% if servantActive and variables.peril_stress == "none" %}
        {% set talent_pth_total = talent_pth_total + 2 %}
    {% endif %}
    {% if ironcladActive and variables.armor_name is not empty %}
        {% set talent_pth_total = talent_pth_total + 2 %}
    {% endif %}
    {% if broadBelliedActive and variables.starving_toggle == false %}
        {% set talent_pth_total = talent_pth_total + 2 %}
    {% endif %}
{% endif %}
<!-- weapons peril bonus -->
{% set weapon_pth = 0 %}
{% set weapon_pth_found = [0] %}
{% set hardened_weapon_name = [""] %}
{% for i in 1..6 %}
    {# Fake the break: Only execute if weapon_pth_found[0] is still 0 #}
    {% if weapon_pth_found[0] == 0 and variables["weapon_active_" ~ i] == true %}
        {% set qualities = variables["weapon_qualities_" ~ i]|lower %}
        {% if qualities is not empty and "hardened" in qualities and "ruined" not in qualities %}
            {% set weapon_pth_found = [1] %}
            {% set hardened_weapon_name = [variables["weapon_name_" ~ i]] %}
        {% endif %}
    {% endif %}
{% endfor %}
{% set weapon_pth = weapon_pth_found[0] %}
{% set weapon_pth_name = hardened_weapon_name[0] %}
<!-- peril threshold finalization -->
{% set peril_threshold_adjusted = peril_base + weapon_pth + talent_pth_total + variables.peril_situational %}
<!-- end of macros -->
