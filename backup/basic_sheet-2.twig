        <!-- TAB #3 temporary fun and order and chaos concept -->
        <!-- TAB #3 Attributes, skills -->
        <!-- TAB #4 Traits, Talents and Gifts -->
        <!--<div class="tab content4"> -->
        <!-- <div class="row card mt-3"> -->
        <div class="row">
            <div class="col-sm-12">
                <div class="row card">
                    <div class="col-sm-12 card-title">Talents</div>
                    {% set tiers = ['basic', 'intermediate', 'advanced'] %}
                    {# Ancestral Talents #}
                    <div class="col-sm-12 border-bottom"><h5>Ancestral Talents</h5></div>
                    {% for tier in tiers %}
                    {% if variables["profession_" ~ tier ~ "_ancestral_talent"] is not empty and variables["profession_" ~ tier ~ "_toggle_9"] == true %}
                        <div class="col-sm-12 content-spacing"><strong>{{ variables["profession_" ~ tier ~ "_ancestral_talent"]|title }}</strong>&nbsp;&nbsp;{{ variables["profession_" ~ tier ~ "_ancestral_talent_desc"] }}</div>
                    {% endif %}
                    {% endfor %}
                    <div class="col-sm-12">
                        <div class="row card-info-label content-spacing">Keywords: Big Folk, Combat Prowess, Deadly Aim, Inhuman Strength, Liquid Poise, Monstrous Body, Mountain Among Men, Undefoot</div>
                    </div>
                     {# Professional Talents #}
                    <div class="col-sm-12 border-bottom"><h5>Professional Talents</h5></div>
                    {% for tier in tiers %}
                    {% if variables["profession_" ~ tier ~ "_profession_talent"] is not empty and variables["profession_" ~ tier ~ "_toggle_8"] == true %}
                        <div class="col-sm-12 content-spacing"><strong>{{ variables["profession_" ~ tier ~ "_profession_talent"]|title }}</strong>&nbsp;&nbsp;{{ variables["profession_" ~ tier ~ "_profession_talent_desc"] }}</div>
                    {% endif %}
                    {% endfor %}
                    {# General Talents #}
                    <div class="col-sm-12 border-bottom"><h5>General Talents</h5></div>
                    {% for tier in tiers %}
                    {% for i in 1..3 %}
                    {% if variables["profession_" ~ tier ~ "_talent_" ~ i] is not empty and variables["profession_" ~ tier ~ "_toggle_" ~ (15 + i)] == true %}
                    <div class="row">
                        <div class="col-sm-12 content-spacing"><strong>{{ variables["profession_" ~ tier ~ "_talent_" ~ i]|title }}</strong>&nbsp;&nbsp;{{ variables["profession_" ~ tier ~ "_talent_" ~ i ~ "_desc"] }}</div>
                    </div>
                    {% endif %}
                    {% endfor %}
                    {% endfor %}
                    <div class="col-sm-12">
                        <div class="row card-info-label content-spacing">Keywords: Salt of the Earth, Instincts</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Magic Profile -->
        <div class="tab content7">
            <div class="row card">
                <div class="col-sm-12">
                    Cast Magic (Occultism):&nbsp;<strong>{{ skill_occultism_total }}</strong>
                    {% for i in 1..3 %}{% if occultism_advance >= i %}<i class="fas fa-square-full"></i>{% else %}<i class="far fa-square-full"></i>{% endif %}{% endfor %}
                        &nbsp;///&nbsp;
                    Intelligence Bonus [IB]:&nbsp;<strong>{{ attribute_intelligence_bonus_final}}</strong>
                        &nbsp;///&nbsp;
                    Willpower Bonus [WB]&nbsp;<strong>{{ attribute_willpower_bonus_final}}</strong>
                </div>
            </div>
            <div class="row card">
                <div class="col-sm-12 card-title"><h3>Spells</h3></div>
            </div>
            <div class="row">
                {% for n in 1..20 %}
                {% if variables["magic_name_" ~ n] is not empty %}
                <div class="col-sm-4">
                    <div class="row card">
                        <div class="col-sm-12 text-title border-bottom">{{ variables["magic_name_" ~ n]|title }}&nbsp;({{ variables["magic_principle_" ~ n] }})</div>
                        <div class="col-sm-12">{{ variables["magic_wellspring_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Distance:</strong>&nbsp;{{ variables["magic_distance_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Materials:</strong>&nbsp;{{ variables["magic_material_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Duration:</strong>&nbsp;{{ variables["magic_duration_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Effect:</strong>&nbsp;{{ variables["magic_effect_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Crit Success:</strong>&nbsp;{{ variables["magic_crit_success_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Crit Failure:</strong>&nbsp;{{ variables["magic_crit_fail_" ~ n] }}</div>
                    </div>
                </div>
            {% endif %}
            {% endfor %}
            </div>
            <!-- end of spells tab-->
            <!-- TAB: Rituals -->
            <div class="row card">
                <div class="col-sm-12 card-title"><h3>Rituals</h3></div>
            </div>
            <div class="row">
            {% for n in 1..10 %}
            {% if variables["ritual_name_" ~ n] is not empty %}
                <div class="col-sm-4 card">
                    <div class="row">
                        <div class="col-sm-12"><h3>{{ variables["ritual_name_" ~ n]|title }}</h3></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12"><strong>Time to Conduct:</strong>&nbsp;{{ variables["ritual_time_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Materials:</strong>&nbsp;{{ variables["ritual_material_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Conditions:</strong>&nbsp;{{ variables["ritual_condition_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Duration:</strong>&nbsp;{{ variables["ritual_duration_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Effect:</strong>&nbsp;{{ variables["ritual_effect_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Crit Success:</strong>&nbsp;{{ variables["ritual_crit_success_" ~ n] }}</div>
                        <div class="col-sm-12"><strong>Crit Failure:</strong>&nbsp;{{ variables["ritual_crit_fail_" ~ n] }}</div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
            </div>
            <!-- end of rituals tab -->
        </div>
        <!-- end of magic tab -->
        <!-- Reward Points, Goals and Progression -->
        <div class="tab content8">
            <div class="row mt-3">
                <div class="col-sm-9">
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h3>Professions & Advancements</h3></div>
                    <!-- TAB: Proffesion, Trait -->
                    {% set tiers = [
                    {name: 'basic', label: 'Basic', rp: '10 RP'},
                    {name: 'intermediate', label: 'Intermediate', rp: '20 RP'},
                    {name: 'advanced', label: 'Advanced', rp: '30 RP'}
                    ] %}
                    {% for tier in tiers %}
                        <div class="col-sm-4">
                        {# Header #}
                            <div class="row">
                                <div class="col-sm-9"><strong>{{ tier.label }}</strong></div>
                                <div class="col-sm-3 text-center"><strong>{{ tier.rp }}</strong></div>
                            </div>
                            {# Profession name #}
                            <div class="row">
                                <div class="col-sm-5"><strong>Profession</strong></div>
                                <div class="col-sm-5">{{ variables["profession_" ~ tier.name] }}</div>
                                <div class="col-sm-2"></div>
                            </div>
                            {# Skill Ranks — toggles 1-6 #}
                            {% for i in 1..6 %}
                            <div class="row">
                                <div class="col-sm-5">Skill Rank</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_skill_" ~ i] }}</div>
                                <div class="col-sm-2">
                                    {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ i]|default(0) == 0 %}
                                        <i class="far fa-circle"></i>
                                    {% else %}
                                        <i class="fas fa-circle"></i>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                            {# Attribute — toggle 7 #}
                            <div class="row">
                                <div class="col-sm-5">Attribute Adjustment</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_attribute"] }}</div>
                                <div class="col-sm-2">
                                {% if variables["profession_" ~ tier.name ~ "_toggle_7"]|default(0) == 0 %}
                                    <i class="far fa-circle"></i>
                                {% else %}
                                    <i class="fas fa-circle"></i>
                                {% endif %}
                                </div>
                            </div>
                            {# Trait — toggle 8 #}
                            <div class="row">
                                <div class="col-sm-5">Professional Talent</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_profession_talent"] }}</div>
                                <div class="col-sm-2">
                                {% if variables["profession_" ~ tier.name ~ "_toggle_8"]|default(0) == 0 %}
                                    <i class="far fa-circle"></i>
                                {% else %}
                                    <i class="fas fa-circle"></i>
                                {% endif %}
                                </div>
                            </div>
                            {# Ancestral Talent — toggle 9 #}
                            <div class="row">
                                <div class="col-sm-5">Ancestral Talent</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_ancestral_talent"] }}</div>
                                <div class="col-sm-2">
                                    {% if variables["profession_" ~ tier.name ~ "_toggle_9"]|default(0) == 0 %}
                                    <i class="far fa-circle"></i>
                                    {% else %}
                                    <i class="fas fa-circle"></i>
                                    {% endif %}
                                </div>
                            </div>
                            {# Bonus Advances — toggles 10-15 #}
                            {% for i in 1..6 %}
                            <div class="row">
                                <div class="col-sm-5">Attribute Modifier</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_bonus_" ~ i] }}</div>
                                <div class="col-sm-2">
                                    {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ (9 + i)]|default(0) == 0 %}
                                    <i class="far fa-circle"></i>
                                    {% else %}
                                    <i class="fas fa-circle"></i>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                            {# Talents — toggles 16-18 #}
                            {% for i in 1..3 %}
                            <div class="row">
                                <div class="col-sm-5">General Talent</div>
                                <div class="col-sm-5 border-bottom text-title text-center">{{ variables["profession_" ~ tier.name ~ "_talent_" ~ i] }}</div>
                                <div class="col-sm-2">
                                    {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ (15 + i)]|default(0) == 0 %}
                                    <i class="far fa-circle"></i>
                                    {% else %}
                                    <i class="fas fa-circle"></i>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h3>Reward Points</h3></div>
                        <div class="col-sm-12">
                            <div class="row">
                                <div class="col-sm-6 border-bottom">Total Reward Points</div>
                                <div class="col-sm-6 border-bottom text-title text-center">{{ variables.reward_points }}</div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">Spent Reward Points</div>
                                <div class="col-sm-6 border-bottom text-title text-center">{{ total_rp_spent }}</div>
                            </div>
                            <div class="row">
                                {% if variables.reward_unique != 0 %} 
                                <div class="col-sm-6">Unique Advances</div>
                                <div class="col-sm-6 border-bottom text-title text-center">{{ variables.reward_unique }} / {{ variables.reward_unique *10 }}</div>
                                {%  endif %}
                            </div>
                            <div class="row">
                                <div class="col-sm-6">Available Reward Points</div>
                                <div class="col-sm-6 border-bottom text-title text-center">{{ variables.reward_points - total_rp_spent }}</div>
                            </div>
                            <div class="row">
                                {% if variables.reward_unique != 0 %} 
                                <div class="col-sm-12 card-info-label">Unique Advances are included in Total RP calculation</div>
                                {%  endif %}
                            </div>
                        </div>
                    </div>
                    {% set visibleAttrs = [] %}
                    {% set visibleValues = [] %}
                    {% for attr in ['agility', 'brawn', 'combat', 'fellowship', 'intelligence', 'perception', 'willpower'] %}
                        {% set bonusValue = attribute(variables, attr ~ '_bonus_custom') %}
                        {% if bonusValue != 0 %}
                            {% set visibleAttrs = visibleAttrs|merge([attr]) %}
                            {% set visibleValues = visibleValues|merge([bonusValue]) %}
                        {% endif %}
                    {% endfor %}
                    {% if visibleAttrs|length > 0 %}
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h3>Custom Bonuses</h3></div>
                        {% for i in 0..(visibleAttrs|length - 1) %}
                        <div class="col-sm-6 border-bottom">{{ visibleAttrs[i]|first|upper }}B</div>
                        <div class="col-sm-6 border-bottom text-center"><strong>{{ visibleValues[i] }}</strong></div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
