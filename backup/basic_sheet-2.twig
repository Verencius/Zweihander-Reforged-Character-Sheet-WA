                        </div>
                        <div class="row">
                            <div class="col-sm-12 card-info-text">All listed modifiers are included in the final score</div>
                        </div>
                        <div class="row"><div class="col-sm-12"><h5>Peril Condition Track</h5></div></div>
                        <div class="row">
                            <div class="col-sm-1">{% if variables.peril_condition_track == "unhindered" %}<i class="fas fa-circle"></i>{% else %}<i class="far fa-circle"></i>{% endif %}</div>
                            <div class="col-sm-11">FINE</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1">{% if variables.peril_condition_track == "imperiled" %}<i class="fas fa-circle"></i>{% else %}<i class="far fa-circle"></i>{% endif %}</div>
                            <div class="col-sm-11">IMPERILED</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1">{% if variables.peril_condition_track == "minus5" %}<i class="fas fa-circle"></i>{% else %}<i class="far fa-circle"></i>{% endif %}</div>
                            <div class="col-sm-11">-5% TO SKILL TESTS</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1">{% if variables.peril_condition_track == "minus10" %}<i class="fas fa-circle"></i>{% else %}<i class="far fa-circle"></i>{% endif %}</div>
                            <div class="col-sm-11">-10% TO SKILL TESTS</div>
