<div id="karta" class="container-fluid">
    <div class="row">
        <div class="col-sm-8">
            <div class="row card">
                <div class="col-sm-12 card-title"><h5>Combat &amp; Conditions</h5></div>
                <div class="col-sm-12 card-content">
                    <div class="row">
                        <div class="col-sm-3">
                            <input value="{{ variables.initiative_temporary is defined ? variables.initiative_temporary }}" class="form-control" id="initiative_temporary" name="initiative_temporary" placeholder="0" type="number" />
                            <div class="card-info-label">Initiative Temp. Modifier</div>
                        </div>
                        <div class="col-sm-3">
                            <input value="{{ variables.peril_situational is defined ? variables.peril_situational }}" class="form-control" id="peril_situational" name="peril_situational" placeholder="0" type="number" />
                            <div class="card-info-label">Peril Situational Modifier</div>
                        </div>
                        <div class="col-sm-3">
                            <input value="{{ variables.damage_situational is defined ? variables.damage_situational }}" class="form-control" id="damage_situational" name="damage_situational" placeholder="0" type="number" />
                            <div class="card-info-label">Damage Situational Modifier</div>
                        </div>
                        <div class="col-sm-3">
                            <input value="{{ variables.action_points|default(3) }}" class="form-control" id="action_points" name="action_points" placeholder="0" type="number" />
                            <div class="card-info-label">Action Points</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="text-title">Peril Condition Track</div>
                            <select class="form-control" id="peril_condition_track" name="peril_condition_track">
                                <option value="fine" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "fine" %}selected="selected"{% endif %}>Fine</option>
                                <option value="imperiled" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "imperiled" %}selected="selected"{% endif %}>Imperiled</option>
                                <option value="minus5" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "minus5" %}selected="selected"{% endif %}>-5% to Skill Tests</option>
                                <option value="minus10" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "minus10" %}selected="selected"{% endif %}>-10% to Skill Tests</option>
                                <option value="minus15" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "minus15" %}selected="selected"{% endif %}>-15% to Skill Tests</option>
                                <option value="exhausted" {% if variables.peril_condition_track is defined and variables.peril_condition_track == "exhausted" %}selected="selected"{% endif %}>Exhausted!</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-title">Peril Stress Condition</div>
                            <select class="form-control" id="peril_stress" name="peril_stress">
                                <option value="none" {% if variables.peril_stress is defined and variables.peril_stress == "none" %}selected="selected"{% endif %}>None</option>
                                <option value="stressed" {% if variables.peril_stress is defined and variables.peril_stress == "stressed" %}selected="selected"{% endif %}>Stressed</option>
                                <option value="frightened" {% if variables.peril_stress is defined and variables.peril_stress == "frightened" %}selected="selected"{% endif %}>Frightened</option>
                                <option value="terrified" {% if variables.peril_stress is defined and variables.peril_stress == "terrified" %}selected="selected"{% endif %}>Terrified</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-title">Damage Condition Track</div>
                            <select class="form-control" id="damage_condition_track" name="damage_condition_track">
                                <option value="alive" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "alive" %}selected="selected"{% endif %}>Alive</option>
                                <option value="lightly" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "lightly" %}selected="selected"{% endif %}>Lightly Wounded</option>
                                <option value="moderately" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "moderately" %}selected="selected"{% endif %}>Moderately Wounded</option>
                                <option value="seriously" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "seriously" %}selected="selected"{% endif %}>Seriously Wounded</option>
                                <option value="grievously" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "grievously" %}selected="selected"{% endif %}>Grievously Wounded</option>
                                <option value="dying" {% if variables.damage_condition_track is defined and variables.damage_condition_track == "dying" %}selected="selected"{% endif %}>Dying!</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-title">Starving</div>
                            <input value="1" {% if variables.starving is defined and variables.starving == 1 %}checked="checked"{% endif %} class="checkbox" id="starving" name="starving" type="checkbox" />
                            <label class="checkbox-label" for="starving">Starving</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 card-info-label content-spacing">Reload the page for the effects to show on the character sheet.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h5>Corruption</h5></div>
                        <div class="col-sm-12 card-content">
                            <div class="row">
                                <div class="col-sm-6">
                                    <input value="{{ variables.corruption is defined ? variables.corruption }}" class="form-control" id="corruption" name="corruption" placeholder="0" type="number" min="0" max="9" />
                                    <div class="card-info-label">Corruption</div>
                                </div>
                                <div class="col-sm-6">
                                    <input value="{{ variables.corruption_permanent is defined ? variables.corruption_permanent }}" class="form-control" id="corruption_permanent" name="corruption_permanent" placeholder="0" type="number" min="0" max="9" />
                                    <div class="card-info-label">Permanent Corruption</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h5>Wealth</h5></div>
                        <div class="col-sm-12 card-content">
                            <div class="row">
                                <div class="col-sm-12">
                                    <input value="{{ variables.silver is defined ? variables.silver }}" class="form-control" id="silver" name="silver" placeholder="0" type="number" min="0" />
                                    <div class="card-info-label">Silver</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="row card">
                        <div class="col-sm-12 card-title"><h5>Reputation</h5></div>
                        <div class="col-sm-12 card-content">
                            <div class="row">
                                <div class="col-sm-12">
                                    <input value="{{ variables.reputation is defined ? variables.reputation }}" class="form-control" id="reputation" name="reputation" placeholder="0" type="number" min="0" />
                                    <div class="card-info-label">Reputation Points</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="row card">
                <div class="col-sm-12 card-title"><h5>Weapons</h5></div>
                <div class="col-sm-12 card-content">
                    {% set weapons_listed = 0 %}
                    {% for i in 1..6 %}
                    {% if variables["weapon_name_" ~ i] is defined and variables["weapon_name_" ~ i] is not empty %}
                    {% set weapons_listed = weapons_listed + 1 %}
                    <div class="row">
                        <div class="col-sm-12">
                            <input value="1" {% if variables["weapon_active_" ~ i] is defined and variables["weapon_active_" ~ i] == 1 %}checked="checked"{% endif %} class="checkbox" id="weapon_active_{{ i }}" name="weapon_active_{{ i }}" type="checkbox" />
                            <label class="checkbox-label" for="weapon_active_{{ i }}"><strong>{{ variables["weapon_name_" ~ i] }}</strong></label>
                            <div class="card-info-label content-spacing">Qualities: {{ variables["weapon_qualities_" ~ i] is defined and variables["weapon_qualities_" ~ i] is not empty ? variables["weapon_qualities_" ~ i] : "-" }} &nbsp;|&nbsp; Damage: {{ variables["weapon_damage_" ~ i] is defined and variables["weapon_damage_" ~ i] is not empty ? variables["weapon_damage_" ~ i] : "-" }}</div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                    {% if weapons_listed == 0 %}
                    <div class="row">
                        <div class="col-sm-12 card-info-label content-spacing">No weapons entered yet. Add them on the Equipment tab of the edit form.</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>