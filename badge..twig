{# ===== data collection (no inputs on this sheet) ===== #}
{% set tier_names = ['basic', 'intermediate', 'advanced'] %}
{% set attr_keys = ['combat', 'brawn', 'agility', 'perception', 'intelligence', 'willpower', 'fellowship'] %}
{% set attr_labels = {combat: 'Combat', brawn: 'Brawn', agility: 'Agility', perception: 'Perception', intelligence: 'Intelligence', willpower: 'Willpower', fellowship: 'Fellowship'} %}
{% set attr_adjust = {combat: 0, brawn: 0, agility: 0, perception: 0, intelligence: 0, willpower: 0, fellowship: 0} %}
{% set attr_modifier = {combat: 0, brawn: 0, agility: 0, perception: 0, intelligence: 0, willpower: 0, fellowship: 0} %}
{% set skill_counts = {} %}

{% for tier in tier_names %}
    {# Skill ranks 1-6: a purchased rank is one advance in the chosen skill #}
    {% for i in 1..6 %}
        {% set skill_name = variables["profession_" ~ tier ~ "_skill_" ~ i]|default('None') %}
        {% if variables["profession_" ~ tier ~ "_toggle_" ~ i] is defined and variables["profession_" ~ tier ~ "_toggle_" ~ i] == 1 and skill_name != 'None' and skill_name != '' %}
            {% set skill_counts = skill_counts|merge({(skill_name): (skill_counts[skill_name]|default(0)) + 1}) %}
        {% endif %}
    {% endfor %}
    {# Attribute adjustment (+5%) #}
    {% if variables["profession_" ~ tier ~ "_toggle_7"] is defined and variables["profession_" ~ tier ~ "_toggle_7"] == 1 %}
        {% set picked_attribute = variables["profession_" ~ tier ~ "_attribute"]|default('None') %}
        {% for k in attr_keys %}
            {% if picked_attribute == attr_labels[k] ~ ' +5%' %}
                {% set attr_adjust = attr_adjust|merge({(k): attr_adjust[k] + 1}) %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {# Attribute modifiers 1-6 (+1 to the attribute bonus) #}
    {% for i in 1..6 %}
        {% if variables["profession_" ~ tier ~ "_toggle_" ~ (9 + i)] is defined and variables["profession_" ~ tier ~ "_toggle_" ~ (9 + i)] == 1 %}
            {% set picked_bonus = variables["profession_" ~ tier ~ "_bonus_" ~ i]|default('None') %}
            {% for k in attr_keys %}
                {% if picked_bonus == attr_labels[k] %}
                    {% set attr_modifier = attr_modifier|merge({(k): attr_modifier[k] + 1}) %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endfor %}

{# current attribute values and bonuses #}
{% set attr_value = {} %}
{% set attr_bonus = {} %}
{% for k in attr_keys %}
    {% set current_value = (variables["attribute_" ~ k]|default(30)) + attr_adjust[k] * 5 %}
    {% set current_bonus = (current_value / 10)|round(0, 'floor') + attr_modifier[k] + (variables[k ~ "_bonus_custom"]|default(0)) %}
    {% set attr_value = attr_value|merge({(k): current_value}) %}
    {% set attr_bonus = attr_bonus|merge({(k): current_bonus}) %}
{% endfor %}

{# current profession: highest tier that has a name #}
{% if variables.profession_advanced_name is defined and variables.profession_advanced_name is not empty %}
    {% set profession_current = variables.profession_advanced_name %}
{% elseif variables.profession_intermediate_name is defined and variables.profession_intermediate_name is not empty %}
    {% set profession_current = variables.profession_intermediate_name %}
{% elseif variables.profession_basic_name is defined and variables.profession_basic_name is not empty %}
    {% set profession_current = variables.profession_basic_name %}
{% else %}
    {% set profession_current = '' %}
{% endif %}

{# current thresholds: Peril = WB + 3, Damage = BB + armor DTh; plus situational modifiers #}
{% set peril_threshold = attr_bonus.willpower + 3 + (variables.peril_situational|default(0)) %}
{% set damage_threshold = attr_bonus.brawn + (variables.armor_dth|default(0)) + (variables.damage_situational|default(0)) %}
{# ===== end of data collection ===== #}

<div id="karta" class="container fluid">
    <div class="col-sm-12">
        <div class="row"><h3>{% if variables.name is defined and variables.name is not empty %}{{ variables.name }}{% else %}Unnamed Character{% endif %}</h3></div>
    </div>
    <div class="col-sm-12">
        <div class="row"><strong>Profession:</strong>&nbsp;{% if profession_current is not empty %}{{ profession_current|title }}{% else %}None{% endif %}</div>
    </div>
    <div class="col-sm-12">
        <div class="row"><strong>Attributes</strong></div>
    </div>
    <div class="col-sm-12">
        <div class="row">
            {% for k in attr_keys %}<div class="col-sm-1"><strong>{{ attr_labels[k]|first }}</strong></div>{% endfor %}
        </div>
        <div class="row">
            {% for k in attr_keys %}<div class="col-sm-1">{{ attr_value[k] }}</div>{% endfor %}
        </div>
        <div class="row">
            {% for k in attr_keys %}<div class="col-sm-1"><strong>{{ attr_labels[k]|first }}B</strong></div>{% endfor %}
        </div>
        <div class="row">
            {% for k in attr_keys %}<div class="col-sm-1">{{ attr_bonus[k] }}</div>{% endfor %}
        </div>
    </div>
    <div class="col-sm-12">
        <div class="row"><strong>Skills</strong></div>
    </div>
    <div class="col-sm-12">
        <div class="row">
            {% if skill_counts|length > 0 %}{% for skill in skill_counts|keys|sort %}{{ skill }}&nbsp;+{{ skill_counts[skill] * 10 }}{% if not loop.last %},&nbsp;{% endif %}{% endfor %}{% else %}-{% endif %}
        </div>
    </div>
    <div class="col-sm-12">
        <div class="row">
            <strong>Peril Threshold:</strong>&nbsp;{{ peril_threshold }}&nbsp;/&nbsp;{{ peril_threshold + 6 }}&nbsp;/&nbsp;{{ peril_threshold + 12 }}&nbsp;/&nbsp;{{ peril_threshold + 18 }}
        </div>
    </div>
    <div class="col-sm-12">
        <div class="row">
            <strong>Damage Threshold:</strong>&nbsp;{{ damage_threshold }}&nbsp;/&nbsp;{{ damage_threshold + 6 }}&nbsp;/&nbsp;{{ damage_threshold + 12 }}&nbsp;/&nbsp;{{ damage_threshold + 18 }}
        </div>
    </div>
</div>