<div id="karta" class="container-fluid">
    <!-- Tabbing -->
    <input class="input-hidden" type="radio" name="tabs" id="tab1" checked/><label for="tab1">Personal</label>
    <input class="input-hidden" type="radio" name="tabs" id="tab2"/><label for="tab2">Equipment</label>
    <input class="input-hidden" type="radio" name="tabs" id="tab7"/><label for="tab7">Magic</label>
    <input class="input-hidden" type="radio" name="tabs" id="tab8"/><label for="tab8">Advancement</label>

    <div class="tab content1">
        <div class="row">
            <div class="col-sm-9">
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Identity</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-3">
                                <input value="{{ variables.name is defined ? variables.name }}" class="form-control" id="name" name="name" placeholder="Character Name" type="text" />
                                <div class="card-info-label">Name</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_ancestry is defined ? variables.personal_ancestry }}" class="form-control" id="personal_ancestry" name="personal_ancestry" placeholder="Ancestry" type="text" />
                                <div class="card-info-label">Ancestry</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_gender is defined ? variables.personal_gender }}" class="form-control" id="personal_gender" name="personal_gender" placeholder="Gender" type="text" />
                                <div class="card-info-label">Gender</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.imageid is defined ? variables.imageid }}" class="form-control" id="imageid" name="imageid" placeholder="Image ID#" type="number" />
                                <div class="card-info-label">ImageID</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_season_of_birth is defined ? variables.personal_season_of_birth }}" class="form-control" id="personal_season_of_birth" name="personal_season_of_birth" placeholder="Season of Birth" type="text" />
                                <div class="card-info-label">Season of Birth</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_place_of_birth is defined ? variables.personal_place_of_birth }}" class="form-control" id="personal_place_of_birth" name="personal_place_of_birth" placeholder="Place of Birth" type="text" />
                                <div class="card-info-label">Place of Birth</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_social_class is defined ? variables.personal_social_class }}" class="form-control" id="personal_social_class" name="personal_social_class" placeholder="Lowborn / Burgher / Nobility" type="text" />
                                <div class="card-info-label">Social Class</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_upbringing is defined ? variables.personal_upbringing }}" class="form-control" id="personal_upbringing" name="personal_upbringing" placeholder="Upbringing" type="text" />
                                <div class="card-info-label">Upbringing</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_patron_deity is defined ? variables.personal_patron_deity }}" class="form-control" id="personal_patron_deity" name="personal_patron_deity" placeholder="Patron Deity" type="text" />
                                <div class="card-info-label">Patron Deity</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_language is defined ? variables.personal_language }}" class="form-control" id="personal_language" name="personal_language" placeholder="Languages" type="text" />
                                <div class="card-info-label">Languages</div>
                            </div>
                            <div class="col-sm-6">
                                <input value="{{ variables.personal_death is defined ? variables.personal_death }}" class="form-control" id="personal_death" name="personal_death" placeholder="Brush With Death" type="text" />
                                <div class="card-info-label">Brush With Death</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Appearance</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_age_group is defined ? variables.personal_age_group }}" class="form-control" id="personal_age_group" name="personal_age_group" placeholder="Young / Middle / Old" type="text" />
                                <div class="card-info-label">Age Group</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_height is defined ? variables.personal_height }}" class="form-control" id="personal_height" name="personal_height" placeholder="Height" type="text" />
                                <div class="card-info-label">Height</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_build is defined ? variables.personal_build }}" class="form-control" id="personal_build" name="personal_build" placeholder="Build" type="text" />
                                <div class="card-info-label">Build</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_complexion is defined ? variables.personal_complexion }}" class="form-control" id="personal_complexion" name="personal_complexion" placeholder="Complexion" type="text" />
                                <div class="card-info-label">Complexion</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_hair_color is defined ? variables.personal_hair_color }}" class="form-control" id="personal_hair_color" name="personal_hair_color" placeholder="Hair Color" type="text" />
                                <div class="card-info-label">Hair Color</div>
                            </div>
                            <div class="col-sm-3">
                                <input value="{{ variables.personal_eye_color is defined ? variables.personal_eye_color }}" class="form-control" id="personal_eye_color" name="personal_eye_color" placeholder="Eye Color" type="text" />
                                <div class="card-info-label">Eye Color</div>
                            </div>
                            <div class="col-sm-6">
                                <input value="{{ variables.personal_distinguishing_marks is defined ? variables.personal_distinguishing_marks }}" class="form-control" id="personal_distinguishing_marks" name="personal_distinguishing_marks" placeholder="Distinguishing Marks" type="text" />
                                <div class="card-info-label">Distinguishing Marks</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Attributes</h3></div>
                    <div class="col-sm-12 card-content">
                        {% set attrs = [
                            {key: 'attribute_combat',      label: 'Combat'},
                            {key: 'attribute_brawn',       label: 'Brawn'},
                            {key: 'attribute_agility',     label: 'Agility'},
                            {key: 'attribute_perception',  label: 'Perception'},
                            {key: 'attribute_intelligence',label: 'Intelligence'},
                            {key: 'attribute_willpower',   label: 'Willpower'},
                            {key: 'attribute_fellowship',  label: 'Fellowship'}
                        ] %}
                        {% for a in attrs %}
                        <div class="row">
                            <div class="col-sm-7 text-title">{{ a.label }}</div>
                            <div class="col-sm-5">
                                <input value="{{ variables[a.key]|default(30) }}" class="form-control" id="{{ a.key }}" name="{{ a.key }}" placeholder="30" type="number" min="0" max="100" />
                            </div>
                        </div>
                        {% endfor %}
                        <div class="row">
                            <div class="col-sm-12 card-info-label">Enter base attribute values. Skill ranks and attribute advances are tracked in the Advancement tab via profession toggles.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-9">
                <!-- Unique Bond -->
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Unique Bond</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="talent_unique_bond" name="talent_unique_bond" rows="2" placeholder="Unique Bond">{{ variables.talent_unique_bond is defined ? variables.talent_unique_bond }}</textarea>
                                <div class="card-info-label">Unique Bond</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Alignment &amp; Corruption</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables.inner_strength is defined ? variables.inner_strength }}" class="form-control" id="alignment_inner_strength" name="inner_strength" placeholder="Inner Strength" type="text" />
                                <div class="card-info-label">Inner Strength</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables.tragic_flaw is defined ? variables.tragic_flaw }}" class="form-control" id="alignment_tragic_flaw" name="tragic_flaw" placeholder="Tragic Flaw" type="text" />
                                <div class="card-info-label">Tragic Flaw</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="injuries" name="injuries" rows="3" placeholder="Injuries">{{ variables.injuries is defined ? variables.injuries }}</textarea>
                                <div class="card-info-label">Injuries</div>
                            </div>
                            <div class="col-sm-12">
                                <textarea class="form-control" id="malignancies" name="malignancies" rows="3" placeholder="Malignancies">{{ variables.malignancies is defined ? variables.malignancies }}</textarea>
                                <div class="card-info-label">Malignancies</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-10">
                                <textarea class="form-control" id="scars" name="scars" rows="3" placeholder="Scars">{{ variables.scars is defined ? variables.scars }}</textarea>
                                <div class="card-info-label">Scars</div>
                            </div>
                            <div class="col-sm-2">
                                <input type="number" class="form-control" name="scars_number" value="{{ variables.scars_number is defined ? variables.scars_number : 0 }}">
                                <div class="card-info-label">Number of Scars. Use this counter if you have Spiritual Defense professional talent</div>
                            </div> 
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Goals</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="personal_goals" name="personal_goals" rows="4" placeholder="Goals and Ambitions">{{ variables.personal_goals is defined ? variables.personal_goals }}</textarea>
                                <div class="card-info-label">Goals &amp; Ambitions</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Reputation</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="reputation_text" name="reputation_text" rows="7" placeholder="What you are known for">{{ variables.reputation_text is defined ? variables.reputation_text }}</textarea>
                                <div class="card-info-label">Reputation (What You Are Known For)</div>
                                <input value="{{ variables.reputation is defined ? variables.reputation }}" class="form-control" id="reputation" name="reputation" placeholder="0" type="number" min="0" />
                                <div class="card-info-label">Reputation Points</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# end tab content1 #}
    <div class="tab content2">
        <!-- Armor -->
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>Armor</h3></div>
            <div class="col-sm-12 card-content">
                <div class="row">
                    <div class="col-sm-4">
                        <input value="{{ variables.armor_name is defined ? variables.armor_name }}" class="form-control" id="armor_name" name="armor_name" placeholder="Armor Name" type="text" />
                        <div class="card-info-label">Armor Name</div>
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables.armor_dth is defined ? variables.armor_dth }}" class="form-control" id="armor_dth" name="armor_dth" placeholder="0" type="number" min="0" max="10" />
                        <div class="card-info-label">DTh Modifier</div>
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables.armor_bb is defined ? variables.armor_bb }}" class="form-control" id="armor_bb" name="armor_bb" placeholder="0" type="number" min="0" max="10" />
                        <div class="card-info-label">BB Requirement</div>
                    </div>
                    <div class="col-sm-4">
                        <input value="{{ variables.armor_qualities is defined ? variables.armor_qualities }}" class="form-control" id="armor_qualities" name="armor_qualities" placeholder="Qualities — keywords: Ruined, Maker's Mark, Ill-fitted"  type="text" />
                        <div class="card-info-label">Qualities</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <input value="{{ variables.armor_clothes is defined ? variables.armor_clothes }}" class="form-control" id="armor_clothes" name="armor_clothes" placeholder="Worn Clothes" type="text" />
                        <div class="card-info-label">Worn Clothes</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Weapons -->
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>Weapons</h3></div>
            <div class="col-sm-12 card-content">
                <div class="row">
                    <div class="col-sm-1 text-title">Active</div>
                    <div class="col-sm-2 text-title">Name</div>
                    <div class="col-sm-2 text-title">Distance</div>
                    <div class="col-sm-2 text-title">Damage</div>
                    <div class="col-sm-2 text-title">Load (AP)</div>
                    <div class="col-sm-3 text-title">Qualities</div>
                </div>
                {% for i in 1..6 %}
                <div class="row">
                    <div class="col-sm-1">
                        <input value="1" {% if variables["weapon_active_" ~ i] is defined and variables["weapon_active_" ~ i] == 1 %}checked="checked"{% endif %} class="checkbox" id="weapon_active_{{ i }}" name="weapon_active_{{ i }}" type="checkbox" />
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables["weapon_name_" ~ i] is defined ? variables["weapon_name_" ~ i] }}" class="form-control" id="weapon_name_{{ i }}" name="weapon_name_{{ i }}" placeholder="Weapon #{{ i }}" type="text" />
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables["weapon_distance_" ~ i] is defined ? variables["weapon_distance_" ~ i] }}" class="form-control" id="weapon_distance_{{ i }}" name="weapon_distance_{{ i }}" placeholder="Distance" type="text" />
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables["weapon_damage_" ~ i] is defined ? variables["weapon_damage_" ~ i] }}" class="form-control" id="weapon_damage_{{ i }}" name="weapon_damage_{{ i }}" placeholder="Damage" type="text" />
                    </div>
                    <div class="col-sm-2">
                        <input value="{{ variables["weapon_load_" ~ i] is defined ? variables["weapon_load_" ~ i] }}" class="form-control" id="weapon_load_{{ i }}" name="weapon_load_{{ i }}" placeholder="Load" type="text" />
                    </div>
                    <div class="col-sm-3">
                        <input value="{{ variables["weapon_qualities_" ~ i] is defined ? variables["weapon_qualities_" ~ i] }}" class="form-control" id="weapon_qualities_{{ i }}" name="weapon_qualities_{{ i }}" placeholder="Ruined / Defensive / Hardened" type="text" />
                    </div>
                </div>
                {% endfor %}
                <div class="row">
                    <div class="col-sm-12 card-info-label content-spacing">Mark a weapon as Active to apply its qualities (Defensive, Hardened, Ruined) to combat calculations. Carrying 3+ weapons triggers IM penalty.</div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <!-- Tools -->
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Tools</h3></div>
                    <div class="col-sm-12 card-content">
                        {% for i in 1..6 %}
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables["tool_" ~ i] is defined ? variables["tool_" ~ i] }}" class="form-control" id="tool_{{ i }}" name="tool_{{ i }}" placeholder="Tool #{{ i }}" type="text" />
                                <div class="card-info-label">Tool {{ i }}</div>
                            </div>
                        </div>
                        {% endfor %}    
                        <div class="row">
                            <div class="col-sm-12 card-info-label content-spacing">Carrying 3+ tools triggers an Initiative Modifier penalty. Each tool beyond 3 applies -1 IM</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <!-- Supplies -->
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Supplies</h3></div>
                    <div class="col-sm-12 card-content">
                        {% for i in 1..6 %}
                        <div class="row">
                            <div class="col-sm-10">
                                <input value="{{ variables["supply_name_" ~ i] is defined ? variables["supply_name_" ~ i] }}" class="form-control" id="supply_name_{{ i }}" name="supply_name_{{ i }}" placeholder="Supply #{{ i }}" type="text" />
                                <div class="card-info-label">Supply {{ i }}</div>
                            </div>
                            <div class="col-sm-2">
                                <input value="{{ variables["supply_rating_" ~ i] is defined ? variables["supply_rating_" ~ i] }}" class="form-control" id="supply_rating_{{ i }}" name="supply_rating_{{ i }}" placeholder="0" type="number" min="0" />
                                <div class="card-info-label">Rating {{ i }}</div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <!-- Small Objects (Memento + object_2..10) -->
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Small Objects</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables.memento is defined ? variables.memento }}" class="form-control" id="memento" name="memento" placeholder="Memento" type="text" />
                                <div class="card-info-label">Memento — hold to ignore Peril Track penalties during Brush With Death scenes</div>
                            </div>
                        </div>
                        {% for i in 2..10 %}
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables["object_" ~ i] is defined ? variables["object_" ~ i] }}" class="form-control" id="object_{{ i }}" name="object_{{ i }}" placeholder="Object #{{ i }} — enter 'Talisman of [Skill]' to apply +5 bonus" type="text" />
                                <div class="card-info-label">Object {{ i }}</div>
                            </div>
                        </div>
                        {% endfor %}
                        <div class="row">
                            <div class="col-sm-12 card-info-label">Entering "Talisman of [Skill]" (e.g. "Talisman of Melee") in any object slot will automatically add +5 to that skill's total in the display view.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <!-- Wealth & Burden -->
                <div class="row card">
                    <div class="col-sm-12 card-title"><h3>Wealth &amp; Burden</h3></div>
                    <div class="col-sm-12 card-content">
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables.silver is defined ? variables.silver }}" class="form-control" id="silver" name="silver" placeholder="0" type="number" min="0" />
                                <div class="card-info-label">Silver (1,000+ SP = 1 Enc)</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="burden" name="burden" rows="2" placeholder="Extra burden carried">{{ variables.burden is defined ? variables.burden }}</textarea>
                                <div class="card-info-label">Extra Burden</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables.burden_penalty is defined ? variables.burden_penalty }}" class="form-control" id="burden_penalty" name="burden_penalty" placeholder="0" type="number" min="0" />
                                <div class="card-info-label">Burden Penalty (IM)</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="property" name="property" rows="2" placeholder="Property, titles and deeds">{{ variables.property is defined ? variables.property }}</textarea>
                                <div class="card-info-label">Property &amp; Titles</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# end tab content2 #}
    <div class="tab content7">
        <!-- Number of spells / rituals -->
        <div class="row">
            <div class="col-sm-6">
                <div class="row card">
                    <div class="col-sm-12 card-content">
                        <input value="{{ variables.spells_count is defined ? variables.spells_count }}" class="form-control" id="spells_count" name="spells_count" placeholder="Number of spells" type="number" min="0" max="20" />
                        <div class="card-info-label">Number of Spell Slots (0–20) — save and reload to update slots</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="row card">
                    <div class="col-sm-12 card-content">
                        <input value="{{ variables.rituals_count is defined ? variables.rituals_count }}" class="form-control" id="rituals_count" name="rituals_count" placeholder="Number of rituals" type="number" min="0" max="10" />
                        <div class="card-info-label">Number of Rituals (0–10) — save and reload to update slots</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Spells -->
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>Spells</h3></div>
        </div>
        <div class="row card-content">
            <div class="col-sm-12">
                <div class="row">
                {% set spell_slots = variables.spells_count|default(0) %}
                {% if spell_slots > 0 %}
                    {% for n in 1..spell_slots %}
                    <div class="col-sm-6 card spell-card">
                        <div class="row">
                            <div class="col-sm-12"><strong>Spell #{{ n }}</strong></div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <input value="{{ variables["magic_name_" ~ n] is defined ? variables["magic_name_" ~ n] }}" class="form-control" id="magic_name_{{ n }}" name="magic_name_{{ n }}" placeholder="Spell Name" type="text" />
                                <div class="card-info-label">Name</div>
                            </div>
                            <div class="col-sm-4">
                                <select class="form-control" id="magic_principle_{{ n }}" name="magic_principle_{{ n }}">
                                    <option value="None" {% if variables["magic_principle_" ~ n] is defined and variables["magic_principle_" ~ n] == "None" %}selected="selected"{% endif %}>— Principle —</option>
                                    <option value="Petty" {% if variables["magic_principle_" ~ n] is defined and variables["magic_principle_" ~ n] == "Petty" %}selected="selected"{% endif %}>Petty Spell</option>
                                    <option value="Lesser" {% if variables["magic_principle_" ~ n] is defined and variables["magic_principle_" ~ n] == "Lesser" %}selected="selected"{% endif %}>Lesser Spell</option>
                                    <option value="Greater" {% if variables["magic_principle_" ~ n] is defined and variables["magic_principle_" ~ n] == "Greater" %}selected="selected"{% endif %}>Greater Spell</option>
                                </select>
                                <div class="card-info-label">Principle</div>
                            </div>
                            <div class="col-sm-4">
                                <select class="form-control" id="magic_wellspring_{{ n }}" name="magic_wellspring_{{ n }}">
                                    <option value="Folk Magic" {% if variables["magic_wellspring_" ~ n] is defined and variables["magic_wellspring_" ~ n] == "Folk Magic" %}selected="selected"{% endif %}>Folk Magic</option>
                                    <option value="Arcane Magic" {% if variables["magic_wellspring_" ~ n] is defined and variables["magic_wellspring_" ~ n] == "Arcane Magic" %}selected="selected"{% endif %}>Arcane Magic</option>
                                    <option value="Divine Magic" {% if variables["magic_wellspring_" ~ n] is defined and variables["magic_wellspring_" ~ n] == "Divine Magic" %}selected="selected"{% endif %}>Divine Magic</option>
                                    <option value="Chaos Magic" {% if variables["magic_wellspring_" ~ n] is defined and variables["magic_wellspring_" ~ n] == "Chaos Magic" %}selected="selected"{% endif %}>Chaos Magic</option>
                                </select>
                                <div class="card-info-label">Wellspring</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <select class="form-control" id="magic_distance_{{ n }}" name="magic_distance_{{ n }}">
                                    <option value="Self" {% if variables["magic_distance_" ~ n] is defined and variables["magic_distance_" ~ n] == "Self" %}selected="selected"{% endif %}>Self</option>
                                    <option value="Close" {% if variables["magic_distance_" ~ n] is defined and variables["magic_distance_" ~ n] == "Close" %}selected="selected"{% endif %}>Close</option>
                                    <option value="CloseNear" {% if variables["magic_distance_" ~ n] is defined and variables["magic_distance_" ~ n] == "CloseNear" %}selected="selected"{% endif %}>Close/Near</option>
                                    <option value="CloseNearFar" {% if variables["magic_distance_" ~ n] is defined and variables["magic_distance_" ~ n] == "CloseNearFar" %}selected="selected"{% endif %}>Close/Near/Far</option>
                                </select>
                                <div class="card-info-label">Distance</div>
                            </div>
                            <div class="col-sm-4">
                                <select class="form-control" id="magic_duration_{{ n }}" name="magic_duration_{{ n }}">
                                    <option value="Focus" {% if variables["magic_duration_" ~ n] is defined and variables["magic_duration_" ~ n] == "Focus" %}selected="selected"{% endif %}>Focus</option>
                                    <option value="Instant" {% if variables["magic_duration_" ~ n] is defined and variables["magic_duration_" ~ n] == "Instant" %}selected="selected"{% endif %}>Instantaneous</option>
                                    <option value="Forever" {% if variables["magic_duration_" ~ n] is defined and variables["magic_duration_" ~ n] == "Forever" %}selected="selected"{% endif %}>Forever</option>
                                    <option value="Special" {% if variables["magic_duration_" ~ n] is defined and variables["magic_duration_" ~ n] == "Special" %}selected="selected"{% endif %}>Special</option>
                                </select>
                                <div class="card-info-label">Duration</div>
                            </div>
                            <div class="col-sm-4">
                                <input value="{{ variables["magic_material_" ~ n] is defined ? variables["magic_material_" ~ n] }}" class="form-control" id="magic_material_{{ n }}" name="magic_material_{{ n }}" placeholder="Materials" type="text" />
                                <div class="card-info-label">Materials</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="magic_effect_{{ n }}" name="magic_effect_{{ n }}" rows="2" placeholder="Effect">{{ variables["magic_effect_" ~ n] is defined ? variables["magic_effect_" ~ n] }}</textarea>
                                <div class="card-info-label">Effect</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <textarea class="form-control" id="magic_crit_success_{{ n }}" name="magic_crit_success_{{ n }}" rows="2" placeholder="Critical Success">{{ variables["magic_crit_success_" ~ n] is defined ? variables["magic_crit_success_" ~ n] }}</textarea>
                                <div class="card-info-label">Critical Success</div>
                            </div>
                            <div class="col-sm-6">
                                <textarea class="form-control" id="magic_crit_fail_{{ n }}" name="magic_crit_fail_{{ n }}" rows="2" placeholder="Critical Failure">{{ variables["magic_crit_fail_" ~ n] is defined ? variables["magic_crit_fail_" ~ n] }}</textarea>
                                <div class="card-info-label">Critical Failure</div>
                            </div>
                        </div>
                    </div>
                    {% if n is even %}<div class="spell-clear"></div>{% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        <!-- Rituals -->
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>Rituals</h3></div>
        </div>
        <div class="row card-content">
            <div class="col-sm-12">
                <div class="row">
                {% set ritual_slots = variables.rituals_count|default(0) %}
                {% if ritual_slots > 0 %}
                    {% for n in 1..ritual_slots %}
                    <div class="col-sm-6 card spell-card">
                        <div class="row">
                            <div class="col-sm-12"><strong>Ritual #{{ n }}</strong></div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <input value="{{ variables["ritual_name_" ~ n] is defined ? variables["ritual_name_" ~ n] }}" class="form-control" id="ritual_name_{{ n }}" name="ritual_name_{{ n }}" placeholder="Ritual Name" type="text" />
                                <div class="card-info-label">Name</div>
                            </div>
                            <div class="col-sm-4">
                                <input value="{{ variables["ritual_time_" ~ n] is defined ? variables["ritual_time_" ~ n] }}" class="form-control" id="ritual_time_{{ n }}" name="ritual_time_{{ n }}" placeholder="Time to Conduct" type="text" />
                                <div class="card-info-label">Time to Conduct</div>
                            </div>
                            <div class="col-sm-4">
                                <input value="{{ variables["ritual_duration_" ~ n] is defined ? variables["ritual_duration_" ~ n] }}" class="form-control" id="ritual_duration_{{ n }}" name="ritual_duration_{{ n }}" placeholder="Duration" type="text" />
                                <div class="card-info-label">Duration</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <input value="{{ variables["ritual_material_" ~ n] is defined ? variables["ritual_material_" ~ n] }}" class="form-control" id="ritual_material_{{ n }}" name="ritual_material_{{ n }}" placeholder="Materials" type="text" />
                                <div class="card-info-label">Materials</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <textarea class="form-control" id="ritual_effect_{{ n }}" name="ritual_effect_{{ n }}" rows="2" placeholder="Effect">{{ variables["ritual_effect_" ~ n] is defined ? variables["ritual_effect_" ~ n] }}</textarea>
                                <div class="card-info-label">Effect</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <textarea class="form-control" id="ritual_crit_success_{{ n }}" name="ritual_crit_success_{{ n }}" rows="2" placeholder="Critical Success">{{ variables["ritual_crit_success_" ~ n] is defined ? variables["ritual_crit_success_" ~ n] }}</textarea>
                                <div class="card-info-label">Critical Success</div>
                            </div>
                            <div class="col-sm-6">
                                <textarea class="form-control" id="ritual_crit_fail_{{ n }}" name="ritual_crit_fail_{{ n }}" rows="2" placeholder="Critical Failure">{{ variables["ritual_crit_fail_" ~ n] is defined ? variables["ritual_crit_fail_" ~ n] }}</textarea>
                                <div class="card-info-label">Critical Failure</div>
                            </div>
                        </div>
                    </div>
                    {% if n is even %}<div class="spell-clear"></div>{% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {# end tab content7 #}
    <div class="tab content8">
        <!-- Reward Points -->
        {# RP calculation (reflects the last saved state of the sheet) #}
        {% set rp_counts = {basic: 0, intermediate: 0, advanced: 0} %}
        {% for rp_tier in ['basic', 'intermediate', 'advanced'] %}
            {% for rp_i in 1..18 %}
                {% set rp_key = "profession_" ~ rp_tier ~ "_toggle_" ~ rp_i %}
                {% if variables[rp_key] is defined and variables[rp_key] == 1 %}
                    {% set rp_counts = rp_counts|merge({(rp_tier): rp_counts[rp_tier] + 1}) %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% set rp_unique_n = variables.reward_unique|default(0) %}
        {% set rp_spent = rp_counts.basic * 10 + rp_counts.intermediate * 20 + rp_counts.advanced * 30 + rp_unique_n * 10 - 90 %}
        {% set rp_left = (variables.reward_points|default(0)) - rp_spent %}
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>Reward Points</h3></div>
            <div class="col-sm-12 card-content">
                <div class="row">
                    <div class="col-sm-6">
                        <input value="{{ variables.reward_points is defined ? variables.reward_points }}" class="form-control" id="reward_points" name="reward_points" placeholder="0" type="number" min="0" />
                        <div class="card-info-label">Total Reward Points</div>
                    </div>
                    <div class="col-sm-6">
                        <input value="{{ variables.reward_unique is defined ? variables.reward_unique }}" class="form-control" id="reward_unique" name="reward_unique" placeholder="0" type="number" min="0" />
                        <div class="card-info-label"># Unique Advances (×10 RP each)</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <input value="{{ rp_spent }}" class="form-control" id="reward_spent" placeholder="0" type="number" readonly="readonly" />
                        <div class="card-info-label">Total RP Spent (marked advances + unique, minus 90 free from Lifepath)</div>
                    </div>
                    <div class="col-sm-6">
                        <input value="{{ rp_left }}" class="form-control" id="reward_left" placeholder="0" type="number" readonly="readonly" />
                        <div class="card-info-label">RP Remaining for Advancement</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 card-info-label">Basic: {{ rp_counts.basic }} × 10 + Intermediate: {{ rp_counts.intermediate }} × 20 + Advanced: {{ rp_counts.advanced }} × 30 + Unique: {{ rp_unique_n }} × 10 − 90 free. Save and reload to refresh.</div>
                </div>
            </div>
        </div>
        {% set tiers = [
            {name: 'basic',        label: 'Basic',        rp: '10 RP / advance'},
            {name: 'intermediate', label: 'Intermediate', rp: '20 RP / advance'},
            {name: 'advanced',     label: 'Advanced',     rp: '30 RP / advance'}
        ] %}
        {% set skill_options = [
            'None','Athletics','Awareness','Blackpowder','Coordination','Craft',
            'Disguise','Folklore','Gamble','Guile','Handling','Insight',
            'Leechcraft','Melee','Occultism','Persuasion','Ranged','Resolve',
            'Stealth','Survival','Thievery','Toughness'
        ] %}
        {% set attr_options = [
            'None',
            'Agility +5%','Brawn +5%','Combat +5%','Fellowship +5%',
            'Intelligence +5%','Perception +5%','Willpower +5%'
        ] %}
        {% set bonus_options = [
            'None','Agility','Brawn','Combat','Fellowship',
            'Intelligence','Perception','Willpower'
        ] %}
        {% for tier in tiers %}
        <div class="row card">
            <div class="col-sm-12 card-title"><h3>{{ tier.label }} Profession &nbsp;<small>{{ tier.rp }}</small></h3></div>
            <div class="col-sm-12 card-content">
            {# Profession Name #}
                <div class="row">
                    <div class="col-sm-12">
                        <input value="{{ variables["profession_" ~ tier.name ~ "_name"] is defined ? variables["profession_" ~ tier.name ~ "_name"] }}" class="form-control" id="profession_{{ tier.name }}_name" name="profession_{{ tier.name }}_name" placeholder="{{ tier.label }} Profession Name" type="text" />
                    <div class="card-info-label">Profession Name</div>
                </div>
            </div>
            {# Skill Ranks 1–6 #}
                {% for i in 1..6 %}
            <div class="row">
            <div class="col-sm-2 text-title">Skill Rank {{ i }}</div>
            <div class="col-sm-9">
                <select class="form-control" id="profession_{{ tier.name }}_skill_{{ i }}" name="profession_{{ tier.name }}_skill_{{ i }}">
                    {% for opt in skill_options %}
                    <option value="{{ opt }}" {% if variables["profession_" ~ tier.name ~ "_skill_" ~ i] is defined and variables["profession_" ~ tier.name ~ "_skill_" ~ i] == opt %}selected="selected"{% endif %}>{{ opt }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ i] is defined and variables["profession_" ~ tier.name ~ "_toggle_" ~ i] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_{{ i }}" name="profession_{{ tier.name }}_toggle_{{ i }}" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_{{ i }}">Purchased</label>
            </div>
        </div>
        {% endfor %}
        {# Attribute Adjustment — toggle 7 #}
        <div class="row">
            <div class="col-sm-2 text-title">Attribute Adjustment</div>
            <div class="col-sm-9">
                <select class="form-control" id="profession_{{ tier.name }}_attribute" name="profession_{{ tier.name }}_attribute">
                    {% for opt in attr_options %}
                    <option value="{{ opt }}" {% if variables["profession_" ~ tier.name ~ "_attribute"] is defined and variables["profession_" ~ tier.name ~ "_attribute"] == opt %}selected="selected"{% endif %}>{{ opt }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_7"] is defined and variables["profession_" ~ tier.name ~ "_toggle_7"] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_7" name="profession_{{ tier.name }}_toggle_7" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_7">Purchased</label>
            </div>
        </div>
        {# Professional Talent — toggle 8 #}
        <div class="row">
            <div class="col-sm-2 text-title">Professional Talent</div>
            <div class="col-sm-1">
                <input value="{{ variables["profession_" ~ tier.name ~ "_profession_talent"]|default('') }}" class="form-control" id="profession_{{ tier.name }}_profession_talent" name="profession_{{ tier.name }}_profession_talent" placeholder="Talent Name" type="text" />
            </div>
            <div class="col-sm-8">
                <input value="{{ variables["profession_" ~ tier.name ~ "_profession_talent_desc"]|default('') }}" class="form-control" id="profession_{{ tier.name }}_profession_talent_desc" name="profession_{{ tier.name }}_profession_talent_desc" placeholder="Description" type="text" />
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_8"] is defined and variables["profession_" ~ tier.name ~ "_toggle_8"] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_8" name="profession_{{ tier.name }}_toggle_8" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_8">Purchased</label>
            </div>
        </div>
        {# Ancestral Talent — toggle 9 #}
        <div class="row">
            <div class="col-sm-2 text-title">Ancestral Talent</div>
            <div class="col-sm-1">
                <input value="{{ variables["profession_" ~ tier.name ~ "_ancestral_talent"]|default('') }}" class="form-control" id="profession_{{ tier.name }}_ancestral_talent" name="profession_{{ tier.name }}_ancestral_talent" placeholder="Ancestral Talent Name" type="text" />
            </div>
            <div class="col-sm-8">
                <input value="{{ variables["profession_" ~ tier.name ~ "_ancestral_talent_desc"]|default('') }}" class="form-control" id="profession_{{ tier.name }}_ancestral_talent_desc" name="profession_{{ tier.name }}_ancestral_talent_desc" placeholder="Description" type="text" />
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_9"] is defined and variables["profession_" ~ tier.name ~ "_toggle_9"] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_9" name="profession_{{ tier.name }}_toggle_9" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_9">Purchased</label>
            </div>
        </div>
        {# Bonus Advances — toggles 10–15 #}
        {% for i in 1..6 %}
        <div class="row">
            <div class="col-sm-2 text-title">Attribute Modifier {{ i }}</div>
            <div class="col-sm-9">
                <select class="form-control" id="profession_{{ tier.name }}_bonus_{{ i }}" name="profession_{{ tier.name }}_bonus_{{ i }}">
                    {% for opt in bonus_options %}
                    <option value="{{ opt }}" {% if variables["profession_" ~ tier.name ~ "_bonus_" ~ i] is defined and variables["profession_" ~ tier.name ~ "_bonus_" ~ i] == opt %}selected="selected"{% endif %}>{{ opt }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ (9 + i)] is defined and variables["profession_" ~ tier.name ~ "_toggle_" ~ (9 + i)] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_{{ 9 + i }}" name="profession_{{ tier.name }}_toggle_{{ 9 + i }}" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_{{ 9 + i }}">Purchased</label>
            </div>
        </div>
        {% endfor %}
        {# General Talents — toggles 16–18 #}
        {% for i in 1..3 %}
        <div class="row">
            <div class="col-sm-2 text-title">General Talent {{ i }}</div>
            <div class="col-sm-1">
                <input value="{{ variables["profession_" ~ tier.name ~ "_talent_" ~ i]|default('') }}" class="form-control" id="profession_{{ tier.name }}_talent_{{ i }}" name="profession_{{ tier.name }}_talent_{{ i }}" placeholder="Talent Name" type="text" />
            </div>
            <div class="col-sm-8">
                <input value="{{ variables["profession_" ~ tier.name ~ "_talent_" ~ i ~ "_desc"]|default('') }}" class="form-control" id="profession_{{ tier.name }}_talent_{{ i }}_desc" name="profession_{{ tier.name }}_talent_{{ i }}_desc" placeholder="Description" type="text" />
            </div>
            <div class="col-sm-1 text-center">
                <input value="1" {% if variables["profession_" ~ tier.name ~ "_toggle_" ~ (15 + i)] is defined and variables["profession_" ~ tier.name ~ "_toggle_" ~ (15 + i)] == 1 %}checked="checked"{% endif %} class="checkbox" id="profession_{{ tier.name }}_toggle_{{ 15 + i }}" name="profession_{{ tier.name }}_toggle_{{ 15 + i }}" type="checkbox" />
                <label class="checkbox-label" style="font-size:14px;font-weight:normal;line-height:1.4;margin:0;" for="profession_{{ tier.name }}_toggle_{{ 15 + i }}">Purchased</label>
            </div>
        </div>
        {% endfor %}
        <div class="row">
            <div class="col-sm-12 card-info-label">Keywords: Salt of the Earth, Instincts, Liquid Poise</div>
        </div>
    </div>
</div>
{% endfor %}
